<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Shell.NavBarIsVisible="True"
             Title="RésultatPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Nom + âge simple -->
            <Label x:Name="lblMessage"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0"/>

            <!-- Âge détaillé -->
            <Label x:Name="lblAgeDetaille"
                   FontSize="18"
                   HorizontalTextAlignment="Center"/>

            <BoxView HeightRequest="1"
                     Color="#DADAE8"
                     Margin="20,8"/>

            <!-- Jour de naissance -->
            <Label x:Name="lblJourNaissance"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>

            <!-- Prochain anniversaire -->
            <Label x:Name="lblProchainAnniv"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>

            <BoxView HeightRequest="1"
                     Color="#DADAE8"
                     Margin="20,8"/>

            <!-- Statut majeur/mineur -->
            <Label x:Name="lblMessageMajorite"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <!-- Catégorie -->
            <Label x:Name="lblCategorie"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>

            <BoxView HeightRequest="1" Color="#DADAE8"/>

            <!-- Bouton retour -->
            <Button Text="Retour"
                    FontSize="18"
                    Clicked="OnRetourClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>